# Application Port
PORT=3000

# Server Environment (Set to production on live server)
NODE_ENV=production

# Canonical Public HTTPS URL for your restaurant
# (All QR codes and redirects use this secure domain)
APP_URL=https://order.yabicafe.com

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_ordering
DB_NAME=restaurant_ordering

# Session Inactivity Timeout (30 mins in ms)
SESSION_TIMEOUT_MS=1800000

# Restaurant Timezone
TZ=Africa/Addis_Ababa